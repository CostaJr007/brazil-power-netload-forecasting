table fact_storage_daily

	measure 'Reservoir storage %' = AVERAGE(fact_storage_daily[storage_pct]) / 100
		formatString: 0.0%

	column subsystem
		dataType: string
		summarizeBy: none
		sourceColumn: subsystem

	column date
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: date

	column storage_pct
		dataType: double
		summarizeBy: sum
		sourceColumn: storage_pct

	column storage_mwmonth
		dataType: double
		summarizeBy: sum
		sourceColumn: storage_mwmonth

	partition fact_storage_daily = m
		mode: import
		source =
				let
				    Fonte = Parquet.Document(File.Contents(PastaDados & "fact_storage_daily.parquet")),
				    Tipos = Table.TransformColumnTypes(Fonte, {{"subsystem", type text}, {"date", type date}, {"storage_pct", type number}, {"storage_mwmonth", type number}})
				in
				    Tipos
