				    Tipos = Table.TransformColumnTypes(Fonte, {{"date", type date}, {"hours", Int64.Type}, {"load_mw", type number}, {"wind_mw", type number}, {"solar_mw", type number}, {"hydro_mw", type number}, {"thermal_mw", type number}, {"net_load_mw", type number}, {"net_load_ramp_mw", type number}, {"inflow_mw", type number}, {"inflow_pct_ltm", type number}, {"storage_pct", type number}, {"wind_curtailment_mw", type number}, {"solar_curtailment_mw", type number}, {"cmo_se", type number}, {"cmo_s", type number}, {"cmo_ne", type number}, {"cmo_n", type number}, {"price_est_se", type number}})
