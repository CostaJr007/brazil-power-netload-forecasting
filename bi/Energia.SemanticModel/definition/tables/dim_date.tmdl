table dim_date
	dataCategory: Time

	column date
		dataType: dateTime
		formatString: yyyy-mm-dd
		isKey
		summarizeBy: none
		sourceColumn: date

	column year
		dataType: int64
		summarizeBy: none
		sourceColumn: year

	column month
		dataType: int64
		summarizeBy: none
		sourceColumn: month

	column month_name
		dataType: string
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: month

	column year_month
		dataType: string
		summarizeBy: none
		sourceColumn: year_month

	column quarter
		dataType: string
		summarizeBy: none
		sourceColumn: quarter

	column iso_week
		dataType: int64
		summarizeBy: none
		sourceColumn: iso_week

	column weekday_num
		dataType: int64
		summarizeBy: none
		sourceColumn: weekday_num

	column weekday
		dataType: string
		summarizeBy: none
		sourceColumn: weekday
		sortByColumn: weekday_num

	column is_weekend
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_weekend

	column is_holiday
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_holiday

	column day_type
		dataType: string
		summarizeBy: none
		sourceColumn: day_type

	partition dim_date = m
		mode: import
		source =
				let
				    Fonte = Parquet.Document(File.Contents(PastaDados & "dim_date.parquet")),
				    Tipos = Table.TransformColumnTypes(Fonte, {{"date", type date}, {"year", Int64.Type}, {"month", Int64.Type}, {"month_name", type text}, {"year_month", type text}, {"quarter", type text}, {"iso_week", Int64.Type}, {"weekday_num", Int64.Type}, {"weekday", type text}, {"is_weekend", type logical}, {"is_holiday", type logical}, {"day_type", type text}})
				in
				    Tipos
