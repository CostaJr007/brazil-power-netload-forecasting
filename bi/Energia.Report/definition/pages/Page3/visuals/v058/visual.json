          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_audit"
                    }
                  },
                  "Property": "Audit forecast (MW)"
                }
              },
              "queryRef": "fact_audit.Audit forecast (MW)",
              "displayName": "Forecast"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_audit"
                    }
                  },
                  "Property": "Audit actual (MW)"
                }
              },
              "queryRef": "fact_audit.Audit actual (MW)",
