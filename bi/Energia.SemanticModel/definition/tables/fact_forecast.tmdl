table fact_forecast
	lineageTag: 63170c07-7d39-49dc-9a96-dee41840c857

	measure 'Latest decision' = CALCULATE(MAX(fact_forecast[decision_date]), ALL(fact_forecast))
		formatString: yyyy-mm-dd
		lineageTag: 550fec6f-0735-4cde-8b07-046aa4a5a5d9

	measure 'Average forecast (MW)' = VAR d = [Latest decision] VAR _s = SELECTEDVALUE(dim_subsystem[subsystem], "SIN") RETURN CALCULATE(AVERAGE(fact_forecast[forecast]), fact_forecast[decision_date] = d, dim_subsystem[subsystem] = _s)
		formatString: #,0
		lineageTag: a5ad0232-7a13-44ba-88a2-7cadde7efae9

	measure 'Forecast band low' = VAR d = [Latest decision] VAR _s = SELECTEDVALUE(dim_subsystem[subsystem], "SIN") RETURN CALCULATE(AVERAGE(fact_forecast[band_low]), fact_forecast[decision_date] = d, dim_subsystem[subsystem] = _s)
		formatString: #,0
		lineageTag: 7198f6d2-4d83-4643-bf24-d177628a8a93

	measure 'Forecast band high' = VAR d = [Latest decision] VAR _s = SELECTEDVALUE(dim_subsystem[subsystem], "SIN") RETURN CALCULATE(AVERAGE(fact_forecast[band_high]), fact_forecast[decision_date] = d, dim_subsystem[subsystem] = _s)
		formatString: #,0
		lineageTag: a63788cd-74c1-4aad-8986-5cf588ab6761

	measure 'Forecast benchmark (MW)' = VAR d = [Latest decision] VAR _s = SELECTEDVALUE(dim_subsystem[subsystem], "SIN") RETURN CALCULATE(AVERAGE(fact_forecast[benchmark]), fact_forecast[decision_date] = d, dim_subsystem[subsystem] = _s)
		formatString: #,0
		lineageTag: 5059dd1d-9e20-4a77-b1f1-dbc2ca211206

	measure 'Forecast peak (MW)' = VAR d = [Latest decision] VAR _s = SELECTEDVALUE(dim_subsystem[subsystem], "SIN") RETURN CALCULATE(MAX(fact_forecast[forecast]), fact_forecast[decision_date] = d, dim_subsystem[subsystem] = _s)
		formatString: #,0
		lineageTag: f358361c-c403-4bcb-a9c9-0532ac16ab77

	measure 'Headline forecast' = VAR d = [Latest decision] RETURN IF(ISBLANK([Average forecast (MW)]), "No forecast for this selection", "Net load expected to average " & FORMAT([Average forecast (MW)] / 1000, "0.0") & " GW, peaking at " & FORMAT([Forecast peak (MW)] / 1000, "0.0") & " GW (decision of " & FORMAT(d, "mmm d") & ")")
		lineageTag: 9527155c-5485-4c25-84d4-ce7abed18843

