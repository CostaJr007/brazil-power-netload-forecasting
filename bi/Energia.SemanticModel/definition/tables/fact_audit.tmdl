table fact_audit

	measure 'Audit model MAE (MW)' = VAR _s = SELECTEDVALUE(dim_subsystem[subsystem], "SIN") RETURN CALCULATE(AVERAGEX(fact_audit, ABS(fact_audit[forecast] - fact_audit[actual])), dim_subsystem[subsystem] = _s)
		formatString: #,0

	measure 'Audit benchmark MAE (MW)' = VAR _s = SELECTEDVALUE(dim_subsystem[subsystem], "SIN") RETURN CALCULATE(AVERAGEX(fact_audit, ABS(fact_audit[benchmark] - fact_audit[actual])), dim_subsystem[subsystem] = _s)
		formatString: #,0

	measure 'Audit error reduction' = DIVIDE([Audit benchmark MAE (MW)] - [Audit model MAE (MW)], [Audit benchmark MAE (MW)])
		formatString: 0.0%

	measure 'Audit actual (MW)' = VAR _s = SELECTEDVALUE(dim_subsystem[subsystem], "SIN") RETURN CALCULATE(AVERAGE(fact_audit[actual]), dim_subsystem[subsystem] = _s)
		formatString: #,0

	measure 'Audit forecast (MW)' = VAR _s = SELECTEDVALUE(dim_subsystem[subsystem], "SIN") RETURN CALCULATE(AVERAGE(fact_audit[forecast]), dim_subsystem[subsystem] = _s)
		formatString: #,0

	measure 'Headline audit' = IF(ISBLANK([Audit model MAE (MW)]), "No audit for this selection", "Replay of " & FORMAT(MIN(fact_audit[date]), "mmm d") & "–" & FORMAT(MAX(fact_audit[date]), "mmm d") & ": model error " & FORMAT(ABS([Audit error reduction]), "0.0%") & IF([Audit error reduction] >= 0, " below", " above") & " the benchmark")

	column subsystem
		dataType: string
		summarizeBy: none
		sourceColumn: subsystem

	column date
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: date

	column hour
		dataType: int64
		summarizeBy: none
		sourceColumn: hour

	column forecast
		dataType: double
		summarizeBy: sum
		sourceColumn: forecast

	column actual
		dataType: double
		summarizeBy: sum
		sourceColumn: actual

	column benchmark
		dataType: double
		summarizeBy: sum
		sourceColumn: benchmark

	column step
		dataType: string
		summarizeBy: none
		sourceColumn: step

	column timestamp
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn
		summarizeBy: none
		sourceColumn: timestamp

	partition fact_audit = m
		mode: import
		source =
				let
				    Fonte = Parquet.Document(File.Contents(PastaDados & "fact_audit.parquet")),
				    Tipos = Table.TransformColumnTypes(Fonte, {{"subsystem", type text}, {"date", type date}, {"hour", Int64.Type}, {"forecast", type number}, {"actual", type number}, {"benchmark", type number}, {"step", type text}, {"timestamp", type datetime}})
				in
				    Tipos
