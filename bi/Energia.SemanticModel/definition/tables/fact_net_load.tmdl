table fact_net_load
	lineageTag: 1ba02195-53fa-4cdc-9545-ff3f40b1455a

	measure 'Model MAE (MW)' = VAR _s = SELECTEDVALUE(dim_subsystem[subsystem], "SIN") RETURN CALCULATE(AVERAGEX(fact_net_load, ABS(fact_net_load[forecast] - fact_net_load[actual])), dim_subsystem[subsystem] = _s)
		formatString: #,0
		lineageTag: 8be3a1a6-e3cd-4b2b-a577-af22c1b7b5c7

	measure 'Benchmark MAE (MW)' = VAR _s = SELECTEDVALUE(dim_subsystem[subsystem], "SIN") RETURN CALCULATE(AVERAGEX(fact_net_load, ABS(fact_net_load[benchmark] - fact_net_load[actual])), dim_subsystem[subsystem] = _s)
		formatString: #,0
		lineageTag: c3e6439e-d137-413e-b3e4-bcd03f3cf316

	measure 'ONS schedule MAE (MW)' = VAR _s = SELECTEDVALUE(dim_subsystem[subsystem], "SIN") RETURN CALCULATE(AVERAGEX(FILTER(fact_net_load, NOT ISBLANK(fact_net_load[ons_schedule])), ABS(fact_net_load[ons_schedule] - fact_net_load[actual])), dim_subsystem[subsystem] = _s)
		formatString: #,0
		lineageTag: c6067e5a-28b4-4c89-9a08-3cb886e29cdf

	measure 'Error reduction vs benchmark' = DIVIDE([Benchmark MAE (MW)] - [Model MAE (MW)], [Benchmark MAE (MW)])
		formatString: 0.0%
		lineageTag: d5ba0471-acbb-468d-ab10-49da93cbe14f

	measure 'Model bias (MW)' = VAR _s = SELECTEDVALUE(dim_subsystem[subsystem], "SIN") RETURN CALCULATE(AVERAGEX(fact_net_load, fact_net_load[forecast] - fact_net_load[actual]), dim_subsystem[subsystem] = _s)
		formatString: #,0
		lineageTag: 0907cde5-7af2-401a-841f-75b5f3f51feb

	measure 'MAPE model' = VAR _s = SELECTEDVALUE(dim_subsystem[subsystem], "SIN") RETURN CALCULATE(AVERAGEX(FILTER(fact_net_load, fact_net_load[actual] <> 0), ABS(fact_net_load[forecast] - fact_net_load[actual]) / ABS(fact_net_load[actual])), dim_subsystem[subsystem] = _s)
		formatString: 0.00%
		lineageTag: c89c700d-a36e-47a4-b882-a1ef8e677b4e

	measure 'Actual (MW)' = VAR _s = SELECTEDVALUE(dim_subsystem[subsystem], "SIN") RETURN CALCULATE(AVERAGE(fact_net_load[actual]), dim_subsystem[subsystem] = _s)
		formatString: #,0
		lineageTag: 09d2baeb-2b6c-4820-8142-9ca2d60695c1

	measure 'Forecast (MW)' = VAR _s = SELECTEDVALUE(dim_subsystem[subsystem], "SIN") RETURN CALCULATE(AVERAGE(fact_net_load[forecast]), dim_subsystem[subsystem] = _s)
		formatString: #,0
		lineageTag: 9d6147f8-a053-48a6-b107-e3187778eebe

	measure 'Benchmark (MW)' = VAR _s = SELECTEDVALUE(dim_subsystem[subsystem], "SIN") RETURN CALCULATE(AVERAGE(fact_net_load[benchmark]), dim_subsystem[subsystem] = _s)
		formatString: #,0
		lineageTag: 4611415f-5f86-41ca-a815-221f513a0e7b

	measure 'Band 80% low' = VAR _s = SELECTEDVALUE(dim_subsystem[subsystem], "SIN") RETURN CALCULATE(AVERAGE(fact_net_load[band_low]), dim_subsystem[subsystem] = _s)
		formatString: #,0
		lineageTag: a2cddec4-5b81-4458-bc09-99c24aae5d86

	measure 'Band 80% high' = VAR _s = SELECTEDVALUE(dim_subsystem[subsystem], "SIN") RETURN CALCULATE(AVERAGE(fact_net_load[band_high]), dim_subsystem[subsystem] = _s)
		formatString: #,0
		lineageTag: db267805-8d68-4091-9090-e798dba1b8c8

	measure '80% band coverage' = VAR _s = SELECTEDVALUE(dim_subsystem[subsystem], "SIN") RETURN CALCULATE(DIVIDE(COUNTROWS(FILTER(fact_net_load, NOT ISBLANK(fact_net_load[band_low]) && fact_net_load[actual] >= fact_net_load[band_low] && fact_net_load[actual] <= fact_net_load[band_high])), COUNTROWS(FILTER(fact_net_load, NOT ISBLANK(fact_net_load[band_low])))), dim_subsystem[subsystem] = _s)
		formatString: 0.0%
		lineageTag: d1553355-bba0-4bfd-96ea-d3bb5ba1da8d

	measure 'Model bias excl. outages (MW)' = CALCULATE([Model bias (MW)], fact_net_load[telemetry_outage] = FALSE())
		formatString: #,0
		lineageTag: 395d6984-c7de-452e-8b37-328f50ae1d40

	measure 'Days evaluated' = VAR _s = SELECTEDVALUE(dim_subsystem[subsystem], "SIN") RETURN CALCULATE(DISTINCTCOUNT(fact_net_load[date]), dim_subsystem[subsystem] = _s)
		formatString: #,0
		lineageTag: 1ddb3b71-05bb-4980-be02-a2619a4b5f4b

	measure 'Days model wins' = SUMX(VALUES(dim_date[date]), IF(NOT ISBLANK([Model MAE (MW)]) && [Model MAE (MW)] < [Benchmark MAE (MW)], 1, 0))
		formatString: #,0
		lineageTag: 8c49229c-dbf2-4fcd-bc85-f287d1d85813

	measure 'Days model wins (%)' = DIVIDE([Days model wins], [Days evaluated])
		formatString: 0%
		lineageTag: cde9118e-4f64-48fd-a636-a912c18f53aa

	measure 'Headline scoreboard' = IF(ISBLANK([Model MAE (MW)]), "No data for this selection", "Model error is " & FORMAT(ABS([Error reduction vs benchmark]), "0.0%") & IF([Error reduction vs benchmark] >= 0, " lower", " higher") & " than the benchmark, beating it on " & FORMAT([Days model wins (%)], "0%") & " of days")
		lineageTag: 7de9d75d-cd6b-4b11-bcc1-638b26dc02c0

