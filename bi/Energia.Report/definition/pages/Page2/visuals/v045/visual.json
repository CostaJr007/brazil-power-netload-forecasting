{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "v045",
  "position": {
    "x": 20,
    "y": 100,
    "z": 4500,
    "height": 260,
    "width": 1240
  },
  "visual": {
    "visualType": "pivotTable",
    "query": {
      "queryState": {
        "Rows": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_components"
                    }
                  },
                  "Property": "component"
                }
              },
              "queryRef": "fact_components.component",
              "active": true
            }
          ]
        },
        "Columns": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_subsystem"
                    }
                  },
                  "Property": "name"
                }
              },
              "queryRef": "dim_subsystem.name"
            }
          ]
        },
        "Values": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_components"
                    }
                  },
                  "Property": "Component model MAE (MW)"
                }
              },
              "queryRef": "fact_components.Component model MAE (MW)"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_components"
                    }
                  },
                  "Property": "Component benchmark MAE (MW)"
                }
              },
              "queryRef": "fact_components.Component benchmark MAE (MW)"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_components"
                    }
                  },
                  "Property": "Component error reduction"
                }
              },
              "queryRef": "fact_components.Component error reduction"
            }
          ]
        }
      }
    },
    "objects": {},
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'MAE by component and subsystem (MW) and error reduction vs the benchmark'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "11.0D"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
