table dim_hour

	column hour
		dataType: int64
		summarizeBy: none
		sourceColumn: hour

	column hour_label
		dataType: string
		summarizeBy: none
		sourceColumn: hour_label

	column day_part
		dataType: string
		summarizeBy: none
		sourceColumn: day_part

	partition dim_hour = m
		mode: import
		source =
				let
				    Fonte = Parquet.Document(File.Contents(PastaDados & "dim_hour.parquet")),
				    Tipos = Table.TransformColumnTypes(Fonte, {{"hour", Int64.Type}, {"hour_label", type text}, {"day_part", type text}})
				in
				    Tipos
