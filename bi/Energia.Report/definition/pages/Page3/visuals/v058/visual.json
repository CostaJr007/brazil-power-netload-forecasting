          }
        },
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#000000'"
                    }
                  }
                }
              }
            }
          },
          "selector": {
            "metadata": "fact_audit.Audit actual (MW)"
          }
        }
      ],
      "categoryAxis": [
        {
          "properties": {
